# nginx site config TEMPLATE for prodstack-web.
#
# This is an envsubst TEMPLATE, not a ready-to-use config. The stock nginx:alpine
# image ships /docker-entrypoint.d/20-envsubst-on-templates.sh, which at container
# START reads every /etc/nginx/templates/*.template, runs `envsubst` over it
# (substituting ONLY tokens that match a defined environment variable), and writes
# the result to /etc/nginx/conf.d/<name without .template>. The Dockerfile copies
# this file to /etc/nginx/templates/default.conf.template, so it renders to
# /etc/nginx/conf.d/default.conf at start, replacing the stock default site.
#
# ${BACKEND_FQDN} is the backend API Container App's public FQDN (e.g.
# prodstack-api.<env-suffix>.francecentral.azurecontainerapps.io). It MUST be set
# as an env var named BACKEND_FQDN on the web Container App — otherwise envsubst
# leaves the literal `${BACKEND_FQDN}` in the rendered config and the proxy breaks.
# Only ${BACKEND_FQDN} is substituted; all `$host`, `$request_uri`, etc. below are
# nginx RUNTIME variables (no matching env var → envsubst leaves them untouched).
#
# Two jobs:
#   1. Serve the built Vite SPA from /usr/share/nginx/html with SPA fallback.
#   2. Reverse-proxy the SAME path prefixes the Vite dev proxy forwards — /api
#      and /builds (see frontend/vite.config.ts `server.proxy`) — to the backend
#      Container App. This keeps the browser on a single origin (prodstack-web),
#      so the session cookie and the SSE log stream are first-party: no CORS, no
#      SameSite=None gymnastics, cookies pass through untouched.
#
# The SSE endpoint (GET /api/builds/:id/logs/stream) lives under /api, so the
# /api location below carries the streaming-safe settings (buffering off, long
# read timeout, HTTP/1.1).

# Upstream = backend Container App public FQDN. Defined as a variable so the
# proxy_pass resolves it at request time via the resolver (avoids nginx caching
# a stale IP across the upstream's Container App revision rolls).
map $host $backend_upstream {
    default ${BACKEND_FQDN};
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Azure-provided DNS; needed because proxy_pass uses a variable hostname.
    resolver 168.63.129.16 valid=30s;
    resolver_timeout 5s;

    # gzip for text assets (images/fonts are already compressed).
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml;

    # --- Block the CI/CD self-deploy endpoint from the public web origin ---
    # `POST /api/admin/deploy` (M6) rolls the platform Container Apps. It's
    # token-gated and GitHub Actions calls the API origin DIRECTLY, so there's no
    # reason to expose it through this same-origin proxy. Defence in depth: 404 it
    # here so the public web FQDN isn't a second attack surface for the deploy
    # token. `^~` wins over the regex-free `/api/` prefix below for this subtree.
    location ^~ /api/admin {
        return 404;
    }

    # --- API reverse proxy ------------------------------------------------
    # Covers /api/* including the SSE stream at /api/builds/:id/logs/stream.
    location /api/ {
        # NOTE: with a *variable* upstream, nginx does NOT append the request
        # URI automatically and DROPS the query string — so we pass $request_uri
        # explicitly. Without this, the OAuth callback (?code=&state=) and any
        # paginated endpoint (?afterSeq=&limit=) would lose their query params.
        proxy_pass https://$backend_upstream$request_uri;
        proxy_http_version 1.1;

        # Upstream is HTTPS with SNI — present the right cert name.
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_FQDN};

        # Preserve the upstream vhost so Container Apps Envoy routes correctly,
        # and tell the backend it's behind HTTPS for secure-cookie / redirect
        # logic. Cookies are intentionally NOT rewritten (default behavior) so
        # the session cookie stays first-party on the prodstack-web origin.
        proxy_set_header Host ${BACKEND_FQDN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;

        # SSE / streaming: never buffer, never cache, keep the connection open
        # for the life of a build. The backend also sends `X-Accel-Buffering:
        # no`, but disabling buffering here is the belt-and-suspenders that
        # guarantees log lines flush to the browser immediately.
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        chunked_transfer_encoding on;

        # Clear the inbound Connection header so the upstream keep-alive isn't
        # forced closed; required for a stable long-lived SSE connection.
        proxy_set_header Connection '';

        # Long read timeout so an idle-but-alive SSE stream (a slow build with
        # gaps between log lines) isn't torn down. 1h covers the worker's
        # BUILD_TIMEOUT_MS (600s) with generous headroom.
        proxy_connect_timeout 30s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    # --- /builds reverse proxy -------------------------------------------
    # The Vite dev proxy also forwards a bare /builds prefix (vite.config.ts).
    # Mirror it so any non-/api build route stays same-origin in prod too.
    location /builds {
        # NOTE: with a *variable* upstream, nginx does NOT append the request
        # URI automatically and DROPS the query string — so we pass $request_uri
        # explicitly. Without this, the OAuth callback (?code=&state=) and any
        # paginated endpoint (?afterSeq=&limit=) would lose their query params.
        proxy_pass https://$backend_upstream$request_uri;
        proxy_http_version 1.1;

        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_FQDN};

        proxy_set_header Host ${BACKEND_FQDN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;

        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        chunked_transfer_encoding on;
        proxy_set_header Connection '';

        proxy_connect_timeout 30s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
    }

    # --- Hashed static assets: immutable, cache hard --------------------
    # Vite emits content-hashed filenames under /assets, so they can be cached
    # forever — a content change produces a new filename.
    location /assets/ {
        try_files $uri =404;
        access_log off;
        # Single explicit Cache-Control (no `expires`, which would emit a second
        # Cache-Control header). Hashed filenames make these safe to cache forever.
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # --- SPA shell: never cache index.html ------------------------------
    # index.html references the hashed assets, so it must always be revalidated
    # or users get stuck on a stale bundle after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires off;
    }

    # --- SPA fallback ---------------------------------------------------
    # Client-side routing: unknown paths return index.html so react-router can
    # handle them. Real asset 404s still 404 via the /assets/ block above.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
