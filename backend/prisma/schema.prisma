generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BuildStatus {
  QUEUED
  CLONING
  BUILDING
  PUSHING
  DEPLOYING
  READY
  FAILED
  CANCELLED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  STEP
  SUCCESS
}

// A project is ACTIVE (its Azure Container App is running / scale-to-zero) or
// STOPPED (the owner explicitly paused it — the Container App is stopped via
// the SDK beginStop, so it reaches 0 replicas and stays there, NOT waking on
// traffic, $0 compute). A STOPPED project rejects manual rebuilds and ignores
// GitHub push webhooks (no build is queued). Resuming starts the app again and,
// if autoDeploy is on, enqueues a build of the newest commit. See the
// "Stop / Resume projects" feature notes in docs/.
enum ProjectStatus {
  ACTIVE
  STOPPED
}

// Preview / PR environments. Each open pull request on a project's repo (when
// previews are enabled and the PR author is trusted — owner/member/collaborator
// on the same repo, never a fork) gets its own ephemeral Azure Container App,
// built and deployed through the exact same Kaniko pipeline as the main app but
// targeting a per-PR app name. PENDING = created, first build not yet deployed;
// ACTIVE = deployed and serving (has liveUrl); FAILED = the latest build failed;
// TORN_DOWN = PR closed or TTL-expired and the Container App was deleted. See
// docs/PREVIEW_ENVIRONMENTS.md.
enum PreviewStatus {
  PENDING
  ACTIVE
  FAILED
  TORN_DOWN
}

model User {
  id                     String    @id @default(cuid())
  githubUserId           Int       @unique
  githubLogin            String
  email                  String?
  avatarUrl              String?
  githubTokenCiphertext  Bytes
  githubTokenIv          Bytes
  githubTokenAuthTag     Bytes
  githubTokenKeyVersion  Int       @default(1)
  // Demo mode (sandboxed public "Try ProdStack" sessions). A demo session is
  // its own ephemeral User row — per-session isolation reuses the existing
  // userId-scoping for free (see docs/DEMO_MODE.md §2). Real users have
  // isDemo=false, demoExpiresAt=null.
  isDemo                 Boolean   @default(false)
  demoExpiresAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  projects               Project[]
  securityEvents         SecurityEvent[]

  // Drives the hourly demo reaper (cleanupDemo): purge expired demo users
  // (cascade removes all their projects/builds/deployments/logs/env vars).
  @@index([isDemo, demoExpiresAt])
}

model Project {
  id                     String       @id @default(cuid())
  userId                 String
  name                   String
  slug                   String
  githubRepoFullName     String
  githubRepoId           Int
  branch                 String       @default("main")
  webhookId              Int?
  webhookSecretCiphertext Bytes
  webhookSecretIv        Bytes
  webhookSecretAuthTag   Bytes
  webhookSecretKeyVersion Int         @default(1)
  containerAppName       String
  liveUrl                String?
  frameworkHint          String?
  // When true (default), a verified GitHub `push` to `branch` auto-enqueues a
  // build (the Vercel/Railway "git push → live" behavior). When false, pushes
  // are acknowledged (200) but no build is queued — the user deploys manually
  // via the "Trigger build" button. Manual rebuilds always ignore this flag.
  autoDeploy             Boolean      @default(true)
  // Stop / Resume: ACTIVE (default) or STOPPED. When STOPPED the owner has
  // paused the deployed app (Azure Container App stopped → 0 replicas, won't
  // wake on traffic); webhooks are ignored and manual rebuilds are rejected
  // until the project is resumed. `stoppedAt` records when it was paused.
  status                 ProjectStatus @default(ACTIVE)
  stoppedAt              DateTime?
  // Preview / PR environments. When true (default), an open pull request from a
  // trusted author auto-spins an ephemeral per-PR Container App (built through
  // the normal pipeline) and tears it down on PR close. Gated behind the global
  // ENABLE_PREVIEWS master switch too. See docs/PREVIEW_ENVIRONMENTS.md.
  previewsEnabled        Boolean      @default(true)
  // Demo mode: denormalized from the owning user's isDemo. A Postgres partial
  // unique index can only reference the table's own columns, so to enforce
  // "one live project per GitHub repo among REAL (non-demo) users" we mirror
  // the flag here instead of joining to User (same pattern + rationale as
  // Build.isDemo above). See the project_repo_live_real NOTE below.
  isDemo                 Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  builds                 Build[]
  deployments            Deployment[]
  envVars                EnvVar[]
  webhookEvents          WebhookEvent[]
  previews               PreviewEnvironment[]

  // NOTE: slug uniqueness is enforced by a hand-maintained *partial* unique
  // index so it only applies to live projects: `CREATE UNIQUE INDEX
  // project_user_slug_live ON "Project"("userId","slug") WHERE "deletedAt" IS
  // NULL;` (migration 20260605200000). A plain `@@unique([userId, slug])` also
  // counted soft-deleted rows, so recreating a project with the same name after
  // a soft-delete collided with the tombstone row (P2002 -> 500). Prisma can't
  // express a WHERE-filtered unique in the schema, so it's invisible here — DO
  // NOT `prisma migrate dev` against a prod DB without re-checking it isn't
  // dropped as "drift". Prod uses `migrate deploy` (committed SQL only, no
  // introspection), so it's safe there.
  //
  // NOTE: a second hand-maintained *partial* unique index makes inbound webhook
  // routing deterministic — `CREATE UNIQUE INDEX project_repo_live_real ON
  // "Project"("githubRepoId") WHERE "deletedAt" IS NULL AND "isDemo" = false;`
  // (migration 20260619120000). The webhook handler resolves a delivery to its
  // project by `githubRepoId` and verifies the HMAC against that project's
  // secret; with no uniqueness, two live real projects on the same repo would
  // make the lookup non-deterministic (dropped deploys / cross-tenant build).
  // Demo rows are excluded because demo sessions reuse synthetic/fixture repo
  // ids. Prisma can't express a WHERE-filtered unique in the schema — applied
  // via committed SQL; DO NOT `prisma migrate dev` against prod without checking
  // it isn't dropped as drift (prod uses `migrate deploy`, committed SQL only).
  @@index([githubRepoId])
}

model EnvVar {
  id              String  @id @default(cuid())
  projectId       String
  key             String
  valueCiphertext Bytes
  valueIv         Bytes
  valueAuthTag    Bytes
  valueKeyVersion Int     @default(1)

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model Build {
  id             String      @id @default(cuid())
  projectId      String
  commitSha      String
  commitMessage  String
  commitAuthor   String
  branch         String
  status         BuildStatus @default(QUEUED)
  imageTag       String?
  acrRunId       String?
  logBlobUrl     String?
  logByteCursor  Int         @default(0)
  // Postgres job-queue fields. `claimedAt`/`claimedBy` are set atomically
  // by the worker's `FOR UPDATE SKIP LOCKED` claim — once claimed, a row
  // is invisible to other workers even if its status is still QUEUED.
  // `attempts` increments on each claim so a poison-pill build can be
  // detected and dropped if it keeps crashing the worker.
  claimedAt      DateTime?
  claimedBy      String?
  attempts       Int         @default(0)
  // Cooperative-cancellation flag (M5 build cancellation). The API sets this
  // to true on `POST /api/builds/:id/cancel` for an already-claimed/in-flight
  // build; the worker's `runBuild` poll-watches it and aborts the kaniko/git
  // child via an AbortController, then marks the build CANCELLED. An unclaimed
  // QUEUED build is cancelled directly by the API without this flag (it just
  // flips status to CANCELLED before any worker can claim it).
  cancelRequested Boolean    @default(false)
  // Demo mode: denormalized from the owning user's isDemo. The worker's
  // claim/recovery queries are hot and index-sensitive, so we avoid a join to
  // User and filter on this flag directly (defense-in-depth — demo builds are
  // also pre-claimed so the worker never sees them). See docs/DEMO_MODE.md §4.
  isDemo         Boolean     @default(false)
  // Preview / PR environments: when set, this build deploys to the ephemeral
  // per-PR Container App tracked by the PreviewEnvironment row instead of the
  // project's main app (and does NOT create a Deployment row or touch
  // Project.liveUrl). NULL for normal main-branch builds. SetNull on preview
  // delete so build history survives a preview teardown/cascade.
  previewId      String?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  errorMessage   String?
  createdAt      DateTime    @default(now())

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preview        PreviewEnvironment? @relation(fields: [previewId], references: [id], onDelete: SetNull)
  logLines       LogLine[]
  deployments    Deployment[]

  @@index([projectId, createdAt])
  @@index([status, claimedAt, createdAt])
  @@index([previewId])
}

model Deployment {
  id            String   @id @default(cuid())
  projectId     String
  buildId       String
  revisionName  String
  // True when this deployment is a rollback to a build that had already been
  // deployed before (i.e. not the build's first deployment). Lets the activity
  // feed and deployments table distinguish "deployed" from "rolled back"
  // without re-deriving it from deployment ordering on every read.
  rolledBack    Boolean  @default(false)
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  build         Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)

  // NOTE: a hand-maintained partial unique index enforces "one active
  // deployment per project": `CREATE UNIQUE INDEX one_active_per_project ON
  // "Deployment"("projectId") WHERE active = true;` (migration
  // 20260516210200). Prisma can't express a WHERE-filtered unique in the schema,
  // so it's invisible here — DO NOT `prisma migrate dev` against a prod DB
  // without re-checking it isn't dropped as "drift". Prod uses `migrate deploy`
  // (applies committed SQL only, no introspection), so it's safe there.
  @@index([projectId, createdAt])
  @@index([buildId])
}

model LogLine {
  id      BigInt   @id @default(autoincrement())
  buildId String
  seq     Int
  ts      DateTime @default(now())
  level   LogLevel @default(INFO)
  message String   @db.Text

  build   Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@unique([buildId, seq])
  @@index([buildId, id])
  // `ts` index backs the log-pruning cleanup job's `LogLine` age query
  // (delete rows older than RETENTION_DAYS_LOGS) so it doesn't full-scan.
  @@index([ts])
}

model WebhookEvent {
  id         String   @id
  projectId  String
  receivedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, receivedAt])
}

// One ephemeral preview deployment per open pull request (see PreviewStatus and
// docs/PREVIEW_ENVIRONMENTS.md). `containerAppName` is a distinct per-PR Azure
// Container App (always min=0/max=1, scale-to-zero). `expiresAt` is a sliding
// TTL backstop refreshed on every push; the hourly reaper tears down previews
// past it even if the PR-closed webhook was missed. `closedAt` is set on
// teardown (PR closed or expired) — kept (not deleted) for history.
model PreviewEnvironment {
  id               String        @id @default(cuid())
  projectId        String
  prNumber         Int
  title            String
  headRef          String
  headSha          String
  authorLogin      String
  status           PreviewStatus @default(PENDING)
  containerAppName String
  liveUrl          String?
  revisionName     String?
  lastBuildId      String?
  expiresAt        DateTime
  closedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builds           Build[]

  // NOTE: a hand-maintained partial unique index enforces "one open preview per
  // (project, PR number)": `CREATE UNIQUE INDEX preview_project_pr_open ON
  // "PreviewEnvironment"("projectId","prNumber") WHERE "closedAt" IS NULL;`
  // (so a PR number is reusable once its preview is torn down). Prisma can't
  // express a WHERE-filtered unique in the schema — applied via committed SQL,
  // see the migration. DO NOT `prisma migrate dev` against prod without checking
  // it isn't dropped as drift; prod uses `migrate deploy` (committed SQL only).
  @@index([projectId, createdAt])
  @@index([status, expiresAt])
}

// Append-only security / audit event trail. App-level security events (login
// success, owner-gate denials, env-var changes, webhook signature failures, ...)
// were previously emitted to Container App stdout only — un-queryable once the
// revision rolled and the logs aged out. This model persists each as a queryable
// row so the owner can review who did what, when, and from where.
//
// APPEND-ONLY: rows are only ever inserted (`recordSecurityEvent`) and read (the
// owner-gated `GET /api/activity/security-events` endpoint). Nothing in app code
// updates or deletes a row. Writes are best-effort — a failed audit insert is
// logged and swallowed (see `services/securityEvents.ts`) so it can never break
// the request it's auditing.
//
// `action` and `outcome` are plain strings (not enums) so a new event type never
// requires a migration. `metadata` carries keys-only structured context (e.g. the
// changed env-var KEY names, a created-vs-updated flag) — NEVER values, secrets,
// tokens, or OAuth codes.
model SecurityEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  // Dotted action key: `auth.login`, `auth.denied_not_owner`,
  // `auth.oauth_state_mismatch`, `env.updated`, `project.created`,
  // `webhook.signature_invalid`, ...
  action        String
  // `allowed` | `denied` | `success` | `failure`.
  outcome       String
  // The GitHub identity that triggered the event. Nullable: a denial can carry a
  // NON-owner actor (the rejected login), and some events have no GitHub actor.
  actorGithubId Int?
  actorLogin    String?
  // The owning User row, when the event maps to one (login success, env change).
  // Nullable + SetNull on delete so the audit row OUTLIVES the user it references
  // (an audit trail you can erase by deleting the actor is not an audit trail).
  userId        String?
  // Optional subject of the event, e.g. `targetType:"project"`, `targetId:<id>`.
  targetType    String?
  targetId      String?
  ip            String?
  metadata      Json?

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}
