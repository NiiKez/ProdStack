# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Every variable here is consumed by backend/src/env.ts.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# --- Database ---
# Matches docker-compose.yml. Override for staging/prod (Key Vault in M2+).
DATABASE_URL=postgresql://prodstack:prodstack@localhost:5432/prodstack

# --- Auth / Crypto ---
# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=
# Signed-cookie secret. Generate with: openssl rand -hex 32
COOKIE_SECRET=
# Optional cookie domain override (leave empty for host-only cookies).
COOKIE_DOMAIN=
# Cookie `Secure` flag override. Leave empty to default to "secure unless
# NODE_ENV=development". Set to `false` only for local dev over plain http.
COOKIE_SECURE=
# AES-256-GCM key for app-side row encryption. base64-encoded 32 bytes.
# Generate with: openssl rand -base64 32
DATA_ENC_KEY=

# --- GitHub OAuth ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# Single-user demo allow-list. When set to a numeric GitHub user id, only that
# user may complete sign-in (everyone else is bounced with a self-host notice)
# — protects the $100 student credit (single-user demo policy).
# Leave empty for local dev / self-hosted forks to allow any GitHub user.
# Find an id with: curl -s https://api.github.com/users/<login> | grep '"id"'
OWNER_GITHUB_ID=

# --- Azure ---
# When true, all Azure SDK calls are stubbed (local dev, tests).
# Set to false in deployed environments; credentials come from the API's
# managed identity via DefaultAzureCredential — no client id/secret needed.
AZURE_STUB=true
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=prodstack
AZURE_REGION=francecentral
ACR_NAME=prodstack
CONTAINER_APPS_ENV_ID=
# Log Analytics workspace customerId (GUID) backing runtime/application logs.
# Optional — only used when AZURE_STUB=false; runtime-log queries hit this
# workspace's ContainerAppConsoleLogs_CL table via @azure/monitor-query. Leave
# empty (or under AZURE_STUB=true) and the runtime-logs endpoint degrades
# gracefully (available:false). The API's managed identity needs Log Analytics
# Reader (logs) + Monitoring Reader (metrics) for the data-plane queries.
LOG_ANALYTICS_WORKSPACE_ID=

# --- Build worker (M3) ---
# How to invoke the build engine:
#   stub   — skip git+kaniko, deploy a hardcoded public image (M2.5 behavior,
#            default for tests + fast local cycles)
#   docker — shell out to `docker run gcr.io/kaniko-project/...` (laptop dev
#            without kaniko/git installed natively)
#   kaniko — invoke `/kaniko/executor` directly (prodstack-builder image)
BUILD_RUNNER_MODE=stub
# Hard timeout per build. Kaniko is SIGKILL'd if exceeded.
BUILD_TIMEOUT_MS=600000
# Scratch dir for clones + per-build auth material. Cleaned up after each
# build. In prodstack-builder this is set to /var/builds.
BUILD_WORK_DIR=/tmp/prodstack-builds
# ACR admin creds — required only when BUILD_RUNNER_MODE != stub. Managed
# identity can't authenticate to the OCI registry protocol that kaniko
# speaks, so we fall back to admin creds (same path as the M2 manual push).
ACR_USERNAME=
ACR_PASSWORD=
# Stable identifier for stale-claim recovery. Default rotates per PID, so
# set this to a fixed value in prod (e.g. the Container App revision name).
WORKER_ID=
# Poll interval when the queue is empty.
WORKER_POLL_INTERVAL_MS=2000

# --- CI/CD self-deploy (M6 "Option B") ---
# Shared token guarding POST /api/admin/deploy, the endpoint GitHub Actions
# calls to roll the platform Container Apps (the API does the roll via its
# managed identity, so the runner never needs Azure RBAC). Leave empty to keep
# the endpoint inert (503 DEPLOY_DISABLED) — the safe default for local dev /
# self-hosted forks. In prod it's a Key Vault secret. Min 16 chars.
# Generate with: openssl rand -hex 32
DEPLOY_TOKEN=

# --- Cost safeguards (M6 §2.14) ---
# Retention windows for the scheduled cleanup jobs (positive integers, days).
# Image GC: delete ACR image tags older than this (moving tags `latest`/
# `latest-success`, active-deployment tags, live platform images, and the
# newest 5 per repo are always kept).
RETENTION_DAYS_IMAGES=30
# Build-log pruning: delete LogLine rows older than this.
RETENTION_DAYS_LOGS=30
# Build pruning: delete terminal (READY/FAILED/CANCELLED) Build rows older than
# this (cascades to their remaining logs/deployments).
RETENTION_DAYS_BUILDS=90
# Shared token guarding POST /api/admin/cleanup/* (manual triggers for the same
# jobs the scheduler runs daily). Leave empty to keep those endpoints inert
# (503 CLEANUP_DISABLED). In prod it's a Key Vault secret. Min 16 chars.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Feature gates ---
# In-process build poll loop. Off by default in dev; in prod it runs ONLY on the
# dedicated prodstack-builder Container App (the API keeps it false).
ENABLE_WORKER=false
# Starts the in-process node-cron cleanup scheduler (ACR image GC + build/log
# pruning). SEPARATE from ENABLE_WORKER: in prod cleanup runs in the API (which
# has ENABLE_WORKER=false), not on the builder. Off by default in dev.
ENABLE_CLEANUP_JOBS=false
# Global degrade switch: refuse new builds, keep existing apps serving.
KILL_SWITCH=false

# --- Demo mode (docs/DEMO_MODE.md) ---
# Master switch for sandboxed public "Try ProdStack" sessions. Off by default
# (demo-login 404s). Safe to enable in prod (NODE_ENV=production, AZURE_STUB=
# false) — demo safety comes from routing + pre-claimed builds, NOT AZURE_STUB.
ENABLE_DEMO=false
# Demo session lifetime in minutes (cookie/User TTL; reaped hourly).
DEMO_TTL_MINUTES=120
# Hard cap on concurrent unexpired demo users (demo-login 503s past this).
DEMO_MAX_ACTIVE=50
# Build-replay time-compression factor (6× ≈ 15s; 1× = real-time).
DEMO_REPLAY_SPEED=6
