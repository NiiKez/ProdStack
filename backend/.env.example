# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Every variable here is consumed by backend/src/env.ts.

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# --- Database ---
# Matches docker-compose.yml. Override for staging/prod (Key Vault in M2+).
DATABASE_URL=postgresql://prodstack:prodstack@localhost:5432/prodstack

# --- Auth / Crypto ---
# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=
# Signed-cookie secret. Generate with: openssl rand -hex 32
COOKIE_SECRET=
# Optional cookie domain override (leave empty for host-only cookies).
COOKIE_DOMAIN=
# Cookie `Secure` flag override. Leave empty to default to "secure unless
# NODE_ENV=development". Set to `false` only for local dev over plain http.
COOKIE_SECURE=
# AES-256-GCM key for app-side row encryption. base64-encoded 32 bytes.
# Generate with: openssl rand -base64 32
DATA_ENC_KEY=

# --- GitHub OAuth ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# --- Azure ---
# When true, all Azure SDK calls are stubbed (local dev, tests).
# Set to false in deployed environments; credentials come from the API's
# managed identity via DefaultAzureCredential — no client id/secret needed.
AZURE_STUB=true
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=prodstack
AZURE_REGION=francecentral
ACR_NAME=prodstack
CONTAINER_APPS_ENV_ID=

# --- Feature gates ---
# In-process build poller + cleanup jobs. Off by default in dev.
ENABLE_WORKER=false
# Global degrade switch: refuse new builds, keep existing apps serving.
KILL_SWITCH=false
