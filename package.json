{
  "name": "prodstack",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@prodstack/api run dev",
    "dev:web": "npm --workspace=@prodstack/web run dev",
    "dev:db": "docker compose up -d postgres",
    "test:integration:api": "npm --workspace=@prodstack/api run test:integration",
    "build": "npm --workspaces --if-present run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
